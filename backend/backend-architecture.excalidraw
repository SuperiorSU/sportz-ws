      "type": "text",
      "x": 87.01837245385084,
      "y": 501.13483686529844,
      "width": 167.93177795410156,
      "height": 63.51223825209971,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
