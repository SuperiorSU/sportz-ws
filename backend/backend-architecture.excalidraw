    {
      "id": "A4AlNKP6CMz7tXS9eXZcP",
      "type": "text",
      "x": -275.26686772944686,
      "y": 373.49400219866317,
      "width": 162.79445744517568,
      "height": 63.51223825209972,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aK",
      "roundness": null,
      "seed": 432656282,
      "version": 211,
      "versionNonce": 911095578,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788190982424,
      "link": null,
      "locked": false,
      "text": "One table cannot\nstore multiple all this\ninfo for different matches\n",
      "fontSize": 12.702447650419943,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One table cannot\nstore multiple all this\ninfo for different matches\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-ZrzSc35IIoxXd7iy1ITE",
      "type": "text",
      "x": -274.1163017370179,
      "y": 436.3008119690328,
      "width": 156.23513793945312,
      "height": 31.756119126049857,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aL",
      "roundness": null,
      "seed": 1134000794,
      "version": 303,
      "versionNonce": 2020361178,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788190982424,
      "link": null,
      "locked": false,
      "text": "That is why the logic will\nconsider events",
      "fontSize": 12.702447650419943,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "That is why the logic will\nconsider events",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Pj3nyksDqs8e6Zqk6NQf1",
      "type": "text",
      "x": -272.6463274636103,
      "y": 487.10882229366104,
      "width": 199.47857666015625,
      "height": 47.63417868907479,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 661461766,
      "version": 439,
      "versionNonce": 728591302,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788190986433,
      "link": null,
      "locked": false,
      "text": "Who did it -- Actor\nWhat is the outcome -- message\nWhen it happend -- Minute",
      "fontSize": 12.702447650419943,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Who did it -- Actor\nWhat is the outcome -- message\nWhen it happend -- Minute",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
