      "frameId": null,
      "index": "aN",
      "roundness": null,
      "seed": 435374470,
      "version": 607,
      "versionNonce": 1246956826,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788190927229,
      "link": null,
      "locked": false,
      "text": "Other details like \nspeed of ball, average, etc \nwill be stored in a JSON\ncollectively",
      "fontSize": 12.702447650419943,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Other details like \nspeed of ball, average, etc \nwill be stored in a JSON\ncollectively",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
