      "isDeleted": false,
      "boundElements": [],
      "updated": 1788269846897,
      "link": null,
      "locked": false,
      "text": "Rest API will:\n    - create the match\n    - Fetch the list of matches\n    - Load the app for the first time",
      "fontSize": 21.131345718947323,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rest API will:\n    - create the match\n    - Fetch the list of matches\n    - Load the app for the first time",
      "autoResize": true,
      "lineHeight": 1.25
    },
